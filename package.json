{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:dsp": "esbuild src/audio/dynamics.ts src/audio/denoise.ts src/audio/superboost.ts src/audio/studioQuality.ts --outdir=.dsp-test --format=esm --out-extension:.js=.mjs && node tests/dsp-smoke.mjs",
    "check": "tsc --noEmit && npm run test:dsp && vite build",
    "test:room": "node tests/room-browser.mjs",
    "test:halo": "node tests/room-halo-browser.mjs",
    "test:room:ux": "node tests/room-ux-browser.mjs",
    "test:audio:recovery": "node tests/audio-recovery-browser.mjs",
    "test:preset:v5": "node tests/preset-v5-browser.mjs",
    "test:preset:audio": "node tests/preset-audio-integrity-browser.mjs",
    "test:orbits": "node tests/rear-orbits-browser.mjs",
    "test:export-match": "node tests/export-match-playback-browser.mjs",
    "test:saturn": "node tests/saturn-lab-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "playwright": "^1.64.1"
  }
}
